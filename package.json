{
  "name": "cursor-agent-bridge",
  "version": "1.7.0",
  "description": "Cursor Agent Bridge — OpenAI-compatible HTTP bridge to Cursor CLI agent mode (CAI-optimized deploy profile)",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "public",
    "docs",
    "model-router.json",
    "scripts/cursor-api-proxy",
    "scripts/restore-acp-to-web.mjs",
    "package.json"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cursor-api-proxy": "dist/cli.js"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "restore-acp-to-web": "node scripts/restore-acp-to-web.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cursor",
    "openai",
    "anthropic",
    "claude-code",
    "bridge",
    "agent",
    "llm",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-launcher": "^1.2.1"
  }
}
